@page
@model SupermarketWEB.Pages.PayModes.IndexModel
@{
    ViewData["Title"] = "Medios de pago";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-page="Create" class="btn btn-success">Nuevo medio de pago</a>
</div>

@if (Model.PayModes.Count == 0)
{
    <p class="text-muted">Aún no hay medios de pago registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Observación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payMode in Model.PayModes)
                {
                    <tr>
                        <td class="fw-semibold">@payMode.Name</td>
                        <td>@payMode.Observation</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@payMode.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="Delete" asp-route-id="@payMode.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

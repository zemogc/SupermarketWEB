@page
@model SupermarketWEB.Pages.PayModes.CreateModel
@{
    ViewData["Title"] = "Nuevo medio de pago";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-6">
        <form method="post">
            <partial name="_PayModeForm" for="PayMode" />
            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-page="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model SupermarketWEB.Models.PayMode

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" autofocus />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Observation" class="form-label"></label>
    <textarea asp-for="Observation" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Observation" class="text-danger"></span>
</div>

@page "{id:int}"
@model SupermarketWEB.Pages.PayModes.DeleteModel
@{
    ViewData["Title"] = "Eliminar medio de pago";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<div class="card mb-3 confirm-card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.PayMode.Name</dd>
            <dt class="col-sm-4">Observación</dt>
            <dd class="col-sm-8">@(Model.PayMode.Observation ?? "—")</dd>
        </dl>
    </div>
</div>

@if (Model.HasSales)
{
    <div class="alert alert-warning">
        Este medio de pago tiene ventas registradas y no puede eliminarse para conservar el historial.
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
}
else
{
    <p>¿Seguro que deseas eliminar este medio de pago? Esta acción no se puede deshacer.</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-page="Index" class="btn btn-link">Cancelar</a>
    </form>
}

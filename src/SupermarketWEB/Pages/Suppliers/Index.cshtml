@page
@model SupermarketWEB.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Proveedores";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-page="Create" class="btn btn-success">Nuevo proveedor</a>
</div>

@if (Model.Suppliers.Count == 0)
{
    <p class="text-muted">Aún no hay proveedores registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>NIT</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th class="text-end">Entradas</th>
                    <th>Última entrada</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model.Suppliers)
                {
                    <tr>
                        <td class="fw-semibold">@supplier.Name</td>
                        <td>@supplier.TaxId</td>
                        <td>@supplier.ContactName</td>
                        <td>@supplier.Phone</td>
                        <td class="text-end">@supplier.ReceiptCount</td>
                        <td>@(supplier.LastReceiptUtc is { } last ? DisplayFormat.DateTime(Model.ToLocal(last)) : "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="Delete" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

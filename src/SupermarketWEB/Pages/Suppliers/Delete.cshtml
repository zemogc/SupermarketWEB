@page "{id:int}"
@model SupermarketWEB.Pages.Suppliers.DeleteModel
@{
    ViewData["Title"] = "Eliminar proveedor";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<div class="card mb-3 confirm-card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Supplier.Name</dd>
            <dt class="col-sm-4">NIT</dt>
            <dd class="col-sm-8">@(Model.Supplier.TaxId ?? "—")</dd>
            <dt class="col-sm-4">Contacto</dt>
            <dd class="col-sm-8">@(Model.Supplier.ContactName ?? "—")</dd>
        </dl>
    </div>
</div>

@if (Model.HasReceipts)
{
    <div class="alert alert-warning">
        Este proveedor tiene entradas de mercancía registradas y no puede eliminarse para conservar el historial.
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
}
else
{
    <p>¿Seguro que deseas eliminar este proveedor? Esta acción no se puede deshacer.</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-page="Index" class="btn btn-link">Cancelar</a>
    </form>
}

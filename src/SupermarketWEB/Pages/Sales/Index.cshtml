@page
@using SupermarketWEB.Models
@model SupermarketWEB.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-page="Create" class="btn btn-success">Nueva venta</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-4 col-md-3">
        <label asp-for="From" class="form-label small">Desde</label>
        <input asp-for="From" type="date" class="form-control" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label asp-for="To" class="form-label small">Hasta</label>
        <input asp-for="To" type="date" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-page="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<div class="alert alert-light border d-flex flex-wrap gap-4">
    <span><strong>@DisplayFormat.Number(Model.CompletedCount)</strong> ventas completadas</span>
    <span>Total vendido: <strong>@DisplayFormat.Currency(Model.CompletedTotal)</strong></span>
</div>

@if (Model.Sales.TotalCount == 0)
{
    <p class="text-muted">No hay ventas en el periodo seleccionado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>N.º</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Medio de pago</th>
                    <th class="text-end">Unidades</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in Model.Sales.Items)
                {
                    var cancelled = sale.Status == SaleStatus.Cancelled;
                    <tr class="@(cancelled ? "text-muted" : null)">
                        <td>@DisplayFormat.SaleNumber(sale.Id)</td>
                        <td>@DisplayFormat.DateTime(Model.ToLocal(sale.CreatedAtUtc))</td>
                        <td>@(sale.CustomerName ?? "Consumidor final")</td>
                        <td>@sale.PayModeName</td>
                        <td class="text-end">@sale.ItemCount</td>
                        <td class="text-end @(cancelled ? "text-decoration-line-through" : null)">@DisplayFormat.Currency(sale.Total)</td>
                        <td>
                            @if (cancelled)
                            {
                                <span class="badge bg-danger">Anulada</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Completada</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(Model.Sales.PageNumber, Model.Sales.TotalPages, Model.Sales.TotalCount)" />
}

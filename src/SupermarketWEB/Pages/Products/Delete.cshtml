@page "{id:int}"
@model SupermarketWEB.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Eliminar producto";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<div class="card mb-3 confirm-card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Product.Name</dd>
            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Model.Product.Category?.Name</dd>
            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">@DisplayFormat.Currency(Model.Product.Price)</dd>
            <dt class="col-sm-4">Stock</dt>
            <dd class="col-sm-8">@Model.Product.Stock</dd>
        </dl>
    </div>
</div>

<p>¿Seguro que deseas eliminar este producto? Esta acción no se puede deshacer.</p>
<form method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-page="Index" class="btn btn-link">Cancelar</a>
</form>

@model SupermarketWEB.Models.Product
@{
    var categoryOptions = (IEnumerable<SelectListItem>)ViewData["CategoryOptions"]!;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" autofocus />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label"></label>
    <select asp-for="CategoryId" asp-items="categoryOptions" class="form-select">
        <option value="">Selecciona una categoría</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" type="number" step="1" min="0" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
</div>

@page
@model SupermarketWEB.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-page="Create" class="btn btn-success">Nuevo producto</a>
</div>

<form method="get" class="row g-2 align-items-center mb-3" role="search">
    <div class="col-md-4">
        <input asp-for="Search" class="form-control" placeholder="Buscar por nombre" aria-label="Buscar productos" />
    </div>
    <div class="col-md-3">
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select" aria-label="Categoría">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input asp-for="LowStock" class="form-check-input" />
            <label asp-for="LowStock" class="form-check-label">Solo stock bajo</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-page="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@if (Model.Products.TotalCount == 0)
{
    <p class="text-muted">No se encontraron productos.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products.Items)
                {
                    <tr>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.Category?.Name</td>
                        <td class="text-end">@DisplayFormat.Currency(product.Price)</td>
                        <td class="text-end">
                            @if (product.Stock == 0)
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                            else if (product.IsLowStock)
                            {
                                <span class="badge bg-warning text-dark">@product.Stock</span>
                            }
                            else
                            {
                                @product.Stock
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(Model.Products.PageNumber, Model.Products.TotalPages, Model.Products.TotalCount)" />
}

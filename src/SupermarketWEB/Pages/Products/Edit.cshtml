@page "{id:int}"
@model SupermarketWEB.Pages.Products.EditModel
@{
    ViewData["Title"] = "Editar producto";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-6">
        <form method="post">
            <partial name="_ProductForm" for="Product" view-data="ViewData" />
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-page="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
    <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Stock actual</div>
                <div class="fs-2 fw-semibold mb-2">@DisplayFormat.Number(Model.CurrentStock)</div>
                <dl class="row small mb-3">
                    <dt class="col-6 fw-normal text-muted">Costo promedio</dt>
                    <dd class="col-6 text-end mb-1">@(Model.AverageCost is { } cost ? DisplayFormat.Currency(cost) : "Sin registrar")</dd>
                    <dt class="col-6 fw-normal text-muted">Margen</dt>
                    <dd class="col-6 text-end mb-0 @(Model.Margin < 0 ? "text-danger fw-semibold" : null)">@DisplayFormat.Percent(Model.Margin)</dd>
                </dl>
                <p class="small text-muted">El stock cambia solo con movimientos registrados, para conservar el historial.</p>
                <div class="d-grid gap-2">
                    <a asp-page="/Inventory/Receive" asp-route-productId="@Model.Product.Id" class="btn btn-outline-success btn-sm">Registrar entrada</a>
                    <a asp-page="/Inventory/Adjust" asp-route-productId="@Model.Product.Id" class="btn btn-outline-secondary btn-sm">Ajustar por conteo</a>
                    <a asp-page="/Inventory/Index" asp-route-productId="@Model.Product.Id" class="btn btn-link btn-sm">Ver movimientos</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

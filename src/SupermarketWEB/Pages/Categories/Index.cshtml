@page
@model SupermarketWEB.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-page="Create" class="btn btn-success">Nueva categoría</a>
</div>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <input asp-for="Search" class="form-control" placeholder="Buscar por nombre" aria-label="Buscar categorías" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

@if (Model.Categories.Count == 0)
{
    <p class="text-muted">No se encontraron categorías.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="text-end">Productos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td class="fw-semibold">@category.Name</td>
                        <td>@category.Description</td>
                        <td class="text-end">
                            <a asp-page="/Products/Index" asp-route-categoryId="@category.Id">@category.ProductCount</a>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

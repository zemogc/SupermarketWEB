@page
@using SupermarketWEB.Models
@model SupermarketWEB.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<h1 class="h2 mb-2">@ViewData["Title"]</h1>
<p class="text-muted">
    Los cajeros registran ventas y clientes. Los administradores además gestionan el catálogo,
    los precios, los usuarios y pueden anular ventas. Al cambiar un rol se cierran las sesiones abiertas de ese usuario.
</p>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Registrado</th>
                <th>Rol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td class="fw-semibold">@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@DisplayFormat.DateTime(Model.ToLocal(user.CreatedAtUtc))</td>
                    <td>
                        @if (user.Id == Model.CurrentUserId)
                        {
                            <span class="badge bg-secondary">@DisplayFormat.RoleName(user.Role) (tú)</span>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="ChangeRole" asp-route-id="@user.Id" class="d-flex gap-2">
                                <select name="role" class="form-select form-select-sm w-auto" aria-label="Rol de @user.FullName">
                                    @foreach (var role in Enum.GetValues<UserRole>())
                                    {
                                        <option value="@role" selected="@(role == user.Role)">@DisplayFormat.RoleName(role)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

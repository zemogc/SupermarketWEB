@page
@model SupermarketWEB.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-page="Create" class="btn btn-success">Nuevo cliente</a>
</div>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <input asp-for="Search" class="form-control" placeholder="Buscar por documento, nombre o correo" aria-label="Buscar clientes" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="Index" class="btn btn-link">Limpiar</a>
        }
    </div>
</form>

@if (Model.Customers.TotalCount == 0)
{
    <p class="text-muted">No se encontraron clientes.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Documento</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Nacimiento</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers.Items)
                {
                    <tr>
                        <td>@customer.DocumentNumber</td>
                        <td class="fw-semibold">@customer.FullName</td>
                        <td>@customer.Phone</td>
                        <td>@customer.Email</td>
                        <td>@DisplayFormat.Date(customer.Birthday)</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="Delete" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(Model.Customers.PageNumber, Model.Customers.TotalPages, Model.Customers.TotalCount)" />
}

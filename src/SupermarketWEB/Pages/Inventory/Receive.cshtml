@page
@model SupermarketWEB.Pages.Inventory.ReceiveModel
@{
    ViewData["Title"] = "Registrar entrada de mercancía";
}

<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.ProductId" class="form-label"></label>
                <select asp-for="Input.ProductId" asp-items="Model.ProductOptions" class="form-select">
                    <option value="">Selecciona un producto</option>
                </select>
                <span asp-validation-for="Input.ProductId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Quantity" class="form-label"></label>
                <input asp-for="Input.Quantity" type="number" min="1" step="1" class="form-control" />
                <span asp-validation-for="Input.Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Note" class="form-label"></label>
                <input asp-for="Input.Note" class="form-control" />
                <span asp-validation-for="Input.Note" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Registrar entrada</button>
            <a asp-page="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

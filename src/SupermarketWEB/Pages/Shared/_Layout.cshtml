<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SupermarketWEB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SupermarketWEB.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-success box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index">SupermarketWEB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="navbar-collapse collapse">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var isAdmin = User.IsInRole(Policies.AdminRole);
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Sales/Index">Ventas</a></li>
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Reports/Index">Reportes</a></li>
                            }
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Categories/Index">Categorías</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-page="/Products/Index">Productos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Customers/Index">Clientes</a></li>
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/PayModes/Index">Medios de pago</a></li>
                                <li class="nav-item"><a class="nav-link" asp-page="/Users/Index">Usuarios</a></li>
                            }
                        </ul>
                        <form method="post" asp-page="/Account/Logout" class="d-flex align-items-center gap-2">
                            <span class="navbar-text small">
                                @User.Identity.Name
                                <span class="badge bg-light text-success ms-1">@(isAdmin ? "Admin" : "Cajero")</span>
                            </span>
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Register">Registrarse</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_StatusMessage" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - SupermarketWEB - <a asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

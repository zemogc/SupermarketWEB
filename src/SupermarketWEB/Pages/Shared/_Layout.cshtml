<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SupermarketWEB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            // Sección activa a partir de la ruta de la página actual (por ejemplo "/Sales/Create").
            var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
            bool IsCurrent(params string[] sections) =>
                sections.Any(s => s == "/Index" ? currentPage == s : currentPage.StartsWith(s, StringComparison.Ordinal));
            string? ActiveClass(params string[] sections) => IsCurrent(sections) ? "active" : null;
            string? AriaCurrent(params string[] sections) => IsCurrent(sections) ? "page" : null;
        }
        <nav class="navbar navbar-expand-lg navbar-dark bg-success box-shadow mb-4" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-page="/Index">SupermarketWEB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="navbar-collapse collapse">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var isAdmin = User.IsInRole(Policies.AdminRole);
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @ActiveClass("/Index")" aria-current="@AriaCurrent("/Index")" asp-page="/Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveClass("/Sales/")" aria-current="@AriaCurrent("/Sales/")" asp-page="/Sales/Index">Ventas</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveClass("/Products/")" aria-current="@AriaCurrent("/Products/")" asp-page="/Products/Index">Productos</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveClass("/Customers/")" aria-current="@AriaCurrent("/Customers/")" asp-page="/Customers/Index">Clientes</a></li>
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link @ActiveClass("/Inventory/")" aria-current="@AriaCurrent("/Inventory/")" asp-page="/Inventory/Index">Inventario</a></li>
                                <li class="nav-item"><a class="nav-link @ActiveClass("/Reports/")" aria-current="@AriaCurrent("/Reports/")" asp-page="/Reports/Index">Reportes</a></li>
                                <li class="nav-item dropdown">
                                    <button type="button" class="nav-link dropdown-toggle btn btn-link @ActiveClass("/Categories/", "/Suppliers/", "/PayModes/", "/Users/")"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        Administración
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item @ActiveClass("/Categories/")" asp-page="/Categories/Index">Categorías</a></li>
                                        <li><a class="dropdown-item @ActiveClass("/Suppliers/")" asp-page="/Suppliers/Index">Proveedores</a></li>
                                        <li><a class="dropdown-item @ActiveClass("/PayModes/")" asp-page="/PayModes/Index">Medios de pago</a></li>
                                        <li><a class="dropdown-item @ActiveClass("/Users/")" asp-page="/Users/Index">Usuarios</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <button type="button" class="nav-link dropdown-toggle btn btn-link text-white" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                    <span class="badge bg-light text-success ms-1">@(isAdmin ? "Admin" : "Cajero")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-page="/Account/Manage">Mi cuenta</a></li>
                                    <li><a class="dropdown-item" asp-page="/Account/ChangePassword">Cambiar contraseña</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Register">Registrarse</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_StatusMessage" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - SupermarketWEB - <a asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
